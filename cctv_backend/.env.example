# ──────────────────────────────────────────────────────
# CCTV Backend – Environment Variables
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────────

# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=cctv_monitoring

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=24h

# Script Execution Server
SCRIPT_SERVER_URL=http://localhost:8000
SCRIPT_SERVER_API_KEY=your_script_server_api_key

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Scheduler Configuration
SCHEDULER_CHECK_INTERVAL=*/1 * * * *
EXECUTION_PREP_TIME_MINUTES=5

# Dashboard login URL quoted in the account-verified email
DASHBOARD_URL=http://www.examscctvmonitoring.com/cctv_analytics/login

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# SMS Configuration (SMSGatewayHub)
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=your_sender_id
SMS_ENTITY_ID=your_entity_id
SMS_CHANNEL=2
SMS_DCS=0
SMS_FLASH=0
SMS_ROUTE=47

# SMS Template IDs (DLT Approved)
SMS_TEMPLATE_MOVEMENT=your_movement_template_id
SMS_TEMPLATE_PROXIMITY=your_proximity_template_id
SMS_TEMPLATE_MOBILE=your_mobile_template_id
SMS_TEMPLATE_SERVERROOM=your_serverroom_template_id
SMS_TEMPLATE_INVIGILATOR=your_invigilator_template_id
SMS_TEMPLATE_OTP=your_otp_template_id

# Alert Phone Numbers (comma-separated)
ALERT_PHONE_NUMBERS=+919999999999,+918888888888
