# ──────────────────────────────────────────────────────
# CCTV Backend – Environment Variables
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────────

# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=cctv_monitoring

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=24h

# Script Execution Server
SCRIPT_SERVER_URL=http://localhost:4000
SCRIPT_SERVER_API_KEY=your_script_server_api_key

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Scheduler Configuration
SCHEDULER_CHECK_INTERVAL=*/1 * * * *
EXECUTION_PREP_TIME_MINUTES=5
