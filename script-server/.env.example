# ──────────────────────────────────────────────────────
# Script Server – Environment Variables
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────────

# Main Backend Connection
MAIN_BACKEND_URL=http://localhost:3000/cctv_analytics/api
API_KEY=your_script_server_api_key

# Polling Configuration
POLL_INTERVAL_MS=30000
MAX_CONCURRENT_SCRIPTS=5
# How many minutes ahead to pre-fetch assignments so they can be queued (default: 3)
LOOKAHEAD_MINUTES=3
# How many minutes overdue to still accept assignments — handles server restarts (default: 30)
GRACE_MINUTES=30

# Script Configuration
SCRIPTS_DIR=./scripts
LOGS_DIR=./logs/executions

# HTTP Server Port
HTTP_PORT=8000

# Worker Configuration (for horizontal scaling)
WORKER_ID=main
WORKER_NAME=Main Server
DISTRIBUTION_MODE=single
# For static distribution, set camera range:
# CAMERA_START_ID=1
# CAMERA_END_ID=5000
