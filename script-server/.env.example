# ──────────────────────────────────────────────────────
# Script Server – Environment Variables
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────────

# Main Backend Connection
MAIN_BACKEND_URL=http://localhost:3000/cctv_analytics/api
API_KEY=your_script_server_api_key

# Polling Configuration
POLL_INTERVAL_MS=30000
MAX_CONCURRENT_SCRIPTS=5
# How many minutes ahead to pre-fetch assignments so they can be queued (default: 3)
LOOKAHEAD_MINUTES=3
# How many minutes overdue to still accept assignments — handles server restarts (default: 30)
GRACE_MINUTES=30

# Script Configuration
SCRIPTS_DIR=./scripts
LOGS_DIR=./logs/executions

# HTTP Server Port
HTTP_PORT=8000

# ──────────────────────────────────────────────────────
# Worker Configuration (Horizontal Scaling)
# ──────────────────────────────────────────────────────
# Main server also processes cameras as Worker 0
WORKER_ID=worker-0
WORKER_NAME=Main Server (Worker 0)

# Distribution mode: 'static' for range-based, 'single' for all cameras
DISTRIBUTION_MODE=static

# Camera range for this worker (Main Server handles first 6,250 cameras)
# Adjust based on your total camera count and number of workers
CAMERA_START_ID=1
CAMERA_END_ID=6250

# Example distribution for 25,000 cameras across 4 nodes:
# Main Server (worker-0):  1 - 6,250
# Worker 1 (192.168.19.43): 6,251 - 12,500
# Worker 2 (192.168.19.42): 12,501 - 18,750
# Worker 3 (192.168.19.41): 18,751 - 25,000
