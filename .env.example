# Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword123
DB_NAME=cctv_monitoring

# Backend Configuration
NODE_ENV=production
PORT=5000
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d

# Email Configuration (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-email-password

# SMS Configuration (SMSGatewayHub)
# Per-client push-alert credentials/templates now live in the `sms_configs` DB
# table (one row per exam_body: NTA, SSC, ...). The env vars below are only the
# fallback account used for OTP and as a default when a client row omits creds.
SMS_API_KEY=your-sms-api-key
SMS_SENDER_ID=SSCSMS
SMS_ENTITY_ID=your-entity-id
SMS_ROUTE=47
SMS_CHANNEL=2
SMS_DCS=0
SMS_FLASH=0
SMS_TEMPLATE_OTP=your-otp-template-id

# Frontend Configuration
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# Script Server Configuration
EXAM_ID=19
SHIFT_ID=1
LINK_TYPE=RTSP

# Ollama Configuration
OLLAMA_HOST=http://ollama:11434

# ============================================
# H200 GPU Optimization Settings
# ============================================

# GPU Device Selection (0 = first GPU, use comma-separated for multi-GPU)
CUDA_VISIBLE_DEVICES=0

# PyTorch Memory Management for H200 (141GB VRAM)
# max_split_size_mb: Maximum size of memory blocks (512MB recommended for H200)
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

# Enable cuDNN v8 API for better performance
TORCH_CUDNN_V8_API_ENABLED=1

# Enable TF32 for faster inference on H200 (Hopper architecture)
NVIDIA_TF32_OVERRIDE=1

# PyTorch Performance Tuning
TORCH_BACKENDS_CUDNN_BENCHMARK=1
TORCH_BACKENDS_CUDA_MATMUL_ALLOW_TF32=1
TORCH_BACKENDS_CUDNN_ALLOW_TF32=1

# Optional: Increase batch sizes for H200 (uncomment to use)
# TCS_CROWD_BATCH_SIZE=256
# TCS_QP_BOX_BATCH_SIZE=256
# TCS_PROXIMITY_BATCH_SIZE=256
# TCS_VISION_BATCH_SIZE=128

# Optional: Increase queue sizes for H200 (uncomment to use)
# TCS_CROWD_QUEUE_SIZE=1024
# TCS_QP_BOX_QUEUE_SIZE=1024
# TCS_PROXIMITY_QUEUE_SIZE=1024

# Optional: Concurrent camera processing (uncomment to use)
# MAX_CONCURRENT_CAMERAS=50
